-- ระบบอนิเมชั่น & การควบคุมการเปิด-ปิด (SAFE TOGGLE LOGIC)
---------------------------------------------------------------------
local defaultSize = UDim2.new(0, 52, 0, 52)
local pressedSize = UDim2.new(0, 43, 0, 43)
local tweenBounce = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local tweenPress = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local tweenRotate = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local isUiOpen = true

-- ปรับไอคอน/เอฟเฟกต์ให้ตรงกับสถานะ isUiOpen ปัจจุบันเสมอ (ไม่แตะ Visible ของปุ่มลอย)
local function SyncToggleIcon()
    local targetRotation = isUiOpen and 0 or 90
    TweenService:Create(LogoImage, tweenRotate, {Rotation = targetRotation}):Play()

    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") then
            effect.Enabled = isUiOpen
        end
    end
end

-- ฟังก์ชันสลับการเปิด/ปิดหน้าต่าง Fluent UI (เรียกเมื่อกดปุ่มลอยเอง)
local function ToggleMainUI()
    isUiOpen = not isUiOpen

    if Fluent.GUI then
        Fluent.GUI.Enabled = isUiOpen
    end

    SyncToggleIcon()
end

-- ผูกปุ่มลอยเข้ากับสถานะจริงของ Fluent.GUI เสมอ
-- ครอบคลุมทุกทางที่ UI อาจถูกปิด/เปิด เช่น กด MinimizeKey (RightControl)
-- ไม่ใช่แค่ตอนกดปุ่มลอยเอง ทำให้ปุ่มลอยไม่ค้างสถานะผิดอีกต่อไป
if Fluent.GUI then
    Fluent.GUI:GetPropertyChangedSignal("Enabled"):Connect(function()
        isUiOpen = Fluent.GUI.Enabled
        SyncToggleIcon()
    end)
end

-- ระบบลากปุ่มรอบหน้าจอ
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

ToggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleBtn.Position

        TweenService:Create(ToggleBtn, tweenPress, {Size = pressedSize}):Play()
        TweenService:Create(BtnStroke, tweenPress, {Transparency = 0, Thickness = 2.6}):Play()

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                TweenService:Create(ToggleBtn, tweenBounce, {Size = defaultSize}):Play()
                TweenService:Create(BtnStroke, tweenBounce, {Transparency = 0.25, Thickness = 2}):Play()
            end
        end)
    end
end)

ToggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        ToggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- กดปุ่มเพื่อเปิด-ปิด UI
ToggleBtn.MouseButton1Click:Connect(function()
    ToggleMainUI()
end)

