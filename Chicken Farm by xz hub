local function GetPlayerPlot()
    local plotsFolder = Workspace:FindFirstChild("Plots")
    if not plotsFolder then return nil end

    for _, plot in ipairs(plotsFolder:GetChildren()) do
        local plotUI = plot:FindFirstChild("PlotUI")
        if plotUI then
            local ui = plotUI:FindFirstChild("UI")
            local playerNameLabel = ui and ui:FindFirstChild("PlayerName")
            if playerNameLabel and string.find(string.lower(playerNameLabel.Text), string.lower(LocalPlayer.Name)) then
                return plot
            end
        end
    end

    return plotsFolder:FindFirstChild(LocalPlayer.Name)
end

local function TriggerTouch(targetPart)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart and targetPart and targetPart:IsA("BasePart") then
        if firetouchinterest then
            firetouchinterest(rootPart, targetPart, 0)
            task.wait(0.05)
            firetouchinterest(rootPart, targetPart, 1)
        end
    end
end

