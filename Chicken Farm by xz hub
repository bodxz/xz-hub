local function _DEC(b64)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    b64 = string.gsub(b64, '[^'..b..'=]', '')
    return (b64:gsub('(.[\1-\255]?)', function(x)
        if (#x < 2) then return '' end
        local r, f = 0, ''
        for i = 1, #x do
            local c = b:find(x:sub(i, i)) - 1
            r = r * 64 + c
        end
        for i = 1, #x - 1 do
            local ch = math.floor(r / 256 ^ (#x - 1 - i)) % 256
            f = f .. string.char(ch)
        end
        return f
    end):gsub('%z+$', ''))
end

