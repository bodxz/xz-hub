-- ลูปทำงานอัตโนมัติ (AUTOMATION LOOP)
---------------------------------------------------------------------
task.spawn(function()
    while true do
        local plot = GetPlayerPlot()
        if plot and plot:FindFirstChild("Buttons") then
            local buttons = plot.Buttons

            -- ส่งไข่
            if Config.AutoDeposit then
                local deposit = buttons:FindFirstChild("DepositEggs")
                local hitbox = deposit and deposit:FindFirstChild("Hitbox")
                if hitbox then TriggerTouch(hitbox) end
            end

            -- เก็บเงิน
            if Config.AutoCollectCash then
                local collect = buttons:FindFirstChild("CollectMoney")
                local btn = collect and collect:FindFirstChild("Button")
                if btn then TriggerTouch(btn) end
            end

            -- รวมไก่
            if Config.AutoMerge then
                local merge = buttons:FindFirstChild("MergeChickens")
                local btn = merge and merge:FindFirstChild("Button")
                if btn then TriggerTouch(btn) end
            end

            -- ซื้อไก่
            if Config.AutoBuyChickens and buttons:FindFirstChild("BuyChickens") then
                local buyModel = buttons.BuyChickens:FindFirstChild(Config.BuyChickenAmount)
                local btn = buyModel and buyModel:FindFirstChild("Button")
                if btn then TriggerTouch(btn) end
            end

            -- อัปเกรดระดับการซื้อ
            if Config.AutoBuyTier then
                local tierUpgrade = buttons:FindFirstChild("UpgradeBuyTier")
                local btn = tierUpgrade and tierUpgrade:FindFirstChild("Button")
                if btn then TriggerTouch(btn) end
            end

            -- อัปเกรดการแปรรูป
            if Config.AutoUpgradeProcess then
                local procUpgrade = buttons:FindFirstChild("UpgradeProcess")
                local btn = procUpgrade and procUpgrade:FindFirstChild("Button")
                if btn then TriggerTouch(btn) end
            end

            -- รับรางวัลกลุ่ม
            if Config.AutoGroupReward then
                local grpReward = buttons:FindFirstChild("CollectGroupReward")
                local btn = grpReward and grpReward:FindFirstChild("Button")
                if btn then TriggerTouch(btn) end
            end
        end
        task.wait(0.3)
    end
end)

